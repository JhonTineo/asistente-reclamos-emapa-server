# Copia este archivo a .env y completa los valores.
# pydantic-settings los lee (ver app/src/infrastructure/config/settings.py).
# Todo tiene un default razonable; solo necesitas rellenar lo que quieras cambiar.


# --- Qdrant (vector store del RAG de normativa) ---
# Nombre de servicio en docker-compose; 127.0.0.1 si corre en el mismo host.
QDRANT_URL=http://127.0.0.1:6333

# --- Inferencia local (Ollama) ---
# Nombre de servicio en docker-compose; 127.0.0.1 si corre en el mismo host.
OLLAMA_BASE_URL=http://ollama:11434
# Modelo de embeddings del RAG (hay que hacerle `ollama pull` en cada Ollama donde corra
# el backend):  docker exec ollama ollama pull qwen3-embedding:0.6b
# Elegido tras comparar 4 modelos con el gold de 30 casos (ver DIAGNOSTICO_RAG.md).
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- Búsqueda normativa escalonada ---
# Orden de prioridad de las colecciones: se argumenta primero con la norma de atención
# de reclamos (sunass_reclamos, TUO 015-2023-SUNASS-CD) y solo si no alcanza se pasa a
# calidad (sunass_reglamento, TUO 058-2023-SUNASS-CD). Una colección que aún no existe
# se omite. Crear las colecciones (con Qdrant y Ollama arriba): `make index`, o
#   python -m app.src.application.services.rag.index_reclamos --recrear
#   python -m app.src.application.services.rag.index_calidad --recrear
NORMATIVA_FUENTES=sunass_reclamos,sunass_reglamento
NORMATIVA_TOP_K=3
# 0.58 vale para qwen3-embedding:0.6b con la instrucción de más abajo: los aciertos puntúan
# >= 0,609 y el ruido (consultas absurdas, anexos que no aplican) llega a 0,565 en el gold de
# 30 casos. Con nomic-embed-text sería 0.70. Recalibrar al cambiar de modelo:
#   python -m app.test.rag.evaluar_busqueda --modo qdrant
NORMATIVA_UMBRAL_SCORE=0.58

# Cambiar OLLAMA_EMBEDDING_MODEL, o estos prefijos, obliga a REINDEXAR las dos colecciones:
# la consulta usa un único prefijo. Van entre comillas porque terminan en espacio; "\n" es
# un salto de línea real.
#   qwen3-embedding  -> consulta: "Instruct: <tarea>\nQuery: "   documento: (vacío)
#   nomic-embed-text -> "search_query: "  /  "search_document: "
#   multilingual-e5  -> "query: "         /  "passage: "
EMBEDDING_QUERY_PREFIX="Instruct: Given a question about a water utility claim, retrieve the regulation article that answers it\nQuery: "
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_DIMENSION=0   # 0 = se detecta consultando al modelo


# --- Proveedores de inferencia externa (API compatible con OpenAI) ---
# El backend los prueba en el orden de deps.PROVEEDORES_EXTERNOS; un proveedor
# sin key cede el turno al siguiente, así que basta con configurar uno.
# Las keys son un FALLBACK: el frontend puede enviar la suya por header
# X-LLM-Api-Key en cada petición.
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENCODE_API_KEY=
PLUGSKY_API_KEY=
GITHUBMODELS_API_KEY=
CEREBRAS_API_KEY=
# Cloudflare Workers AI necesita ADEMÁS el id de cuenta (va en la URL).
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=



