# Copia este archivo a .env y completa los valores.
# pydantic-settings los lee (ver app/src/infrastructure/config/settings.py).
# Todo tiene un default razonable; solo necesitas rellenar lo que quieras cambiar.


# --- Qdrant (vector store del RAG de normativa) ---
# Nombre de servicio en docker-compose; 127.0.0.1 si corre en el mismo host.
QDRANT_URL=http://127.0.0.1:6333

# --- Inferencia local (Ollama) ---
# Nombre de servicio en docker-compose; 127.0.0.1 si corre en el mismo host.
OLLAMA_BASE_URL=http://ollama:11434
# Modelo de embeddings del RAG (hay que hacerle `ollama pull`).
OLLAMA_EMBEDDING_MODEL=nomic-embed-text


# --- Proveedores de inferencia externa (API compatible con OpenAI) ---
# El backend los prueba en el orden de deps.PROVEEDORES_EXTERNOS; un proveedor
# sin key cede el turno al siguiente, así que basta con configurar uno.
# Las keys son un FALLBACK: el frontend puede enviar la suya por header
# X-LLM-Api-Key en cada petición.
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENCODE_API_KEY=
PLUGSKY_API_KEY=
GITHUBMODELS_API_KEY=
CEREBRAS_API_KEY=
# Cloudflare Workers AI necesita ADEMÁS el id de cuenta (va en la URL).
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=



