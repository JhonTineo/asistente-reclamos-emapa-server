# Copia este archivo a .env y completa los valores para tu entorno.
# pydantic-settings lee estas variables automáticamente (ver
# app/src/infrastructure/config/settings.py).

# --- COMBO DE INFERENCIA EXTERNA -------------------------------------------
# Cinco proveedores compatibles con la API de OpenAI. El backend los intenta EN
# EL ORDEN definido en deps.PROVEEDORES_EXTERNOS: si uno falla, pasa al
# siguiente. Un proveedor sin API key simplemente falla y cede el turno, así
# que puedes empezar con solo OpenRouter e ir sumando el resto.
#
# La inferencia LOCAL (Ollama) es un modo aparte y NO participa de este combo.

# OpenRouter — agregador. Primero del combo; sirve el modelo por defecto.
OPENROUTER_API_KEY=sk-or-v1-tu-api-key
OPENROUTER_MODELS=openai/gpt-4o-mini,openai/gpt-oss-20b:free

# Cerebras — ~30M tok/mes gratis. https://cloud.cerebras.ai
# NOTA (verificado 2026-07-25): la cuenta gratuita puede requerir habilitar
# facturación (402 payment_required) para servir estos modelos aunque el
# plan gratuito los liste. Confirma en cloud.cerebras.ai > tu cuenta > Billing.
CEREBRAS_API_KEY=
CEREBRAS_MODELS=zai-glm-4.7,gpt-oss-120b

# Groq — ~15M tok/mes gratis, latencia muy baja. https://console.groq.com
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b

# OpenCode Zen — modelos free sin tope publicado. https://opencode.ai/zen
# Los ids son SIN prefijo "opencode/" (verificado contra /v1/models real).
OPENCODE_API_KEY=
OPENCODE_MODELS=deepseek-v4-flash-free,nemotron-3-ultra-free

# Cloudflare Workers AI — necesita ADEMÁS el id de cuenta, porque va en la URL.
# Capa gratuita ~10K Neurons/día (del orden de 150 respuestas): es la red de
# seguridad del combo, no un proveedor principal.
# Ids verificados 2026-07-25 contra /ai/models/search (llevan sufijo fp8/fast;
# los ids "pelados" del catálogo antiguo ya no existen).
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODELS=@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/meta/llama-3.1-8b-instruct-fp8

# --- Ollama (modelo local de generación/embeddings) ---
# El valor correcto depende de DÓNDE corre Ollama respecto al backend:
#
#   - docker-compose LOCAL (backend y Ollama son contenedores en la misma red,
#     definidos en docker-compose.yml): usar el nombre del servicio.
#       OLLAMA_BASE_URL=http://ollama:11434
#
#   - RunPod (backend y Ollama corren en el mismo pod/contenedor, o Ollama se
#     accede como si fuera local a esa máquina): usar localhost.
#       OLLAMA_BASE_URL=http://127.0.0.1:11434
#
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_GENERATOR_MODEL=qwen2.5:3b
# Modelo de embeddings de la normativa. Descargarlo en cada Ollama donde corra el backend:
#   docker exec ollama ollama pull qwen3-embedding:0.6b
# Elegido tras comparar 4 modelos con el gold de 30 casos (ver DIAGNOSTICO_RAG.md).
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- Qdrant (vector store para RAG de normativa) ---
# Misma lógica que OLLAMA_BASE_URL: nombre de servicio en docker-compose local,
# localhost si Qdrant corre en el mismo pod/contenedor (p.ej. en RunPod).
#   docker-compose local: QDRANT_URL=http://qdrant:6333
#   RunPod (mismo pod):    QDRANT_URL=http://127.0.0.1:6333
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=sunass_reglamento

# --- Búsqueda normativa escalonada ---
# Orden de prioridad de las colecciones: se argumenta primero con la norma de
# atención de reclamos (sunass_reclamos, TUO 015-2023-SUNASS-CD) y solo si el LLM
# no puede sustentar el hallazgo con ella se pasa a calidad (sunass_reglamento,
# TUO 058-2023-SUNASS-CD). Una colección que aún no existe se omite.
# Crear las colecciones (desde la raíz del backend, con Qdrant y Ollama arriba):
#   python -m app.src.application.services.rag.index_reclamos --recrear
#   python -m app.src.application.services.rag.index_calidad --recrear
NORMATIVA_FUENTES=sunass_reclamos,sunass_reglamento
NORMATIVA_TOP_K=3
# 0.58 vale para qwen3-embedding:0.6b con la instrucción de más abajo: los aciertos puntúan >= 0,609
# y el ruido (consultas absurdas, anexos que no aplican) llega a 0,565 en el gold de 30 casos.
# Con nomic-embed-text sería 0.70. Recalibrar al cambiar de modelo:
#   python -m app.test.rag.evaluar_busqueda --modo qdrant
NORMATIVA_UMBRAL_SCORE=0.58

# Cambiar OLLAMA_EMBEDDING_MODEL, o estos prefijos, obliga a REINDEXAR las dos colecciones
# (index_reclamos --recrear e index_calidad --recrear): la consulta usa un único prefijo.
# Van entre comillas porque terminan en espacio; "\n" es un salto de línea real.
#   qwen3-embedding  -> consulta: "Instruct: <tarea>\nQuery: "   documento: (vacío)
#   nomic-embed-text -> "search_query: "  /  "search_document: "
#   multilingual-e5  -> "query: "         /  "passage: "
EMBEDDING_QUERY_PREFIX="Instruct: Given a question about a water utility claim, retrieve the regulation article that answers it\nQuery: "
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_DIMENSION=0   # 0 = se detecta consultando al modelo

# --- Timeouts / reintentos ---
TIMEOUT_SECONDS=60
MAX_RETRIES=2

# --- API EMAPA ---
EMAPA_API_BASE_URL=https://comercial.emapasanmartin.com:8889/sysco-comercial/backend
# El token de EMAPA no se fija aquí: se envía por header Authorization en cada
# request desde el frontend (ver EMAPA_ACCESS_TOKEN solo si se necesita un
# valor por defecto para pruebas locales).
EMAPA_ACCESS_TOKEN=
